# cp .env.example .env
# --- Neo4j Database (Local Docker or Neo4j AuraDB) ---
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USER=<your-aura-username>
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=<your-aura-database>

# --- Primary pipeline LLM (OpenAI) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_PIPELINE_MODEL=gpt-4.1-mini
OPENAI_GENERATION_MODEL=gpt-4.1-mini

# --- LLM-as-a-Judge ---
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-4o-mini

# --- Optional Groq fallback only; not required by the submission pipeline ---
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-20b

# --- Hugging Face Access Token ---
HF_TOKEN=hf_...
