# cp .env.example .env
# --- Neo4j Database (Local Docker hoặc Neo4j AuraDB) ---
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# --- Extraction & Generation LLM (Groq) ---
GROQ_API_KEY=gsk_...
# Current replacement after Groq retired the Llama IDs on 2026-08-16.
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_GENERATION_MODEL=openai/gpt-oss-20b

# --- LLM-as-a-Judge (OpenAI hoặc Groq) ---
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...

# --- Hugging Face gated dataset access ---
HF_TOKEN=hf_...

# --- Notebook execution ---
LAB_RUN_MODE=smoke
